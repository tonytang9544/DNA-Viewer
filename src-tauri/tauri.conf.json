{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Molecular Cloning Studio",
  "version": "0.1.0",
  "identifier": "org.dnaviewer.molecular-cloning-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Molecular Cloning Studio",
        "width": 1200,
        "height": 820,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
