{
  "name": "molecular-cloning-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "postinstall": "patch-package",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && biome check src vite.config.ts",
    "lint": "biome lint src vite.config.ts",
    "format": "biome format --write src vite.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "seqviz": "^3.10.25"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
